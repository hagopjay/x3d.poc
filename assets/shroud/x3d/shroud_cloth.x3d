     <MetadataString containerField='value' name='jje_model' reference='id: jje.model; tag: fitted; cite: jje1984; unit: -; JJE spectral model' value='&quot;r(lambda, h) = (a + b*lambda) * [1 + c*(lambda - lambda_prime)*h]&quot;'/>
