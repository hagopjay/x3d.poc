     <MetadataDouble containerField='value' name='weave_band_repeat_threads' reference='id: weave.band_repeat_threads; tag: measured; cite: vial1989; unit: threads; Herringbone repeat (warp threads one way, then back)' value='41 39'/>
     <MetadataDouble containerField='value' name='weave_band_width_cm' reference='id: weave.band_width_cm; tag: derived; cite: vial1989; unit: cm; Herringbone band width' value='1.07 1.02'/>
