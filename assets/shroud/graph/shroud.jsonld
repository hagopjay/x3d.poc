   }
  },
  {
   "@id": "kb:constant/convention.axes",
   "@type": "Quantity",
   "name": "Axes",
   "tag": "convention",
   "value": "Y up; flat cloth in the XZ plane; u across the width (X), v along the length (Z)",
   "group": "conventions",
   "source": {
    "@id": "kb:doc/plan"
   }
  },
  {
   "@id": "kb:constant/convention.map_grid",
   "@type": "Quantity",
   "name": "Map grid",
   "tag": "convention",
   "value": "[2048, 8192]",
   "unit": "texels (u x v)",
   "group": "conventions",
   "note": "One grid for every map and compute pass, about 0.54 mm per texel on the pre-2002 cloth. Shipped maps here are 512 x 2048 because the image carries no detail finer than 5 mm (see image.resolution_floor_m); tools/derive.py can bake at the full grid.",
   "source": {
    "@id": "kb:doc/plan"
   }
  },
  {
   "@id": "kb:constant/convention.h_range",
   "@type": "Quantity",
   "name": "Image field h",
   "tag": "convention",
   "value": "[0, 1]",
   "group": "conventions",
   "note": "h = 0 is background linen, h = 1 the most intense image point (the nose tip). Scorch may use h > 1 (same chemistry, more of it).",
   "cites": {
    "@id": "kb:ref/jje1984"
   },
   "source": [
    {
     "@id": "kb:doc/plan"
    },
    {
     "@id": "kb:doc/v3"
    }
   ]
  },
