  {
   "@id": "kb:correction/halftone",
   "@type": "Correction",
   "name": "Half-tone versus smooth colour",
   "tag": "convention",
   "kind": "contradiction",
   "was": "PRD: each fibril is coloured or not; v3: colour is a smooth function of h",
   "now": "Both hold: coloured fraction f = h x f_max, and each coloured fibril takes the JJE colour at h = 1/f_max, so the average is exactly v3's.",
   "decidedBy": "plan",
   "affects": {
    "@id": "kb:constant/colour.half_tone_fmax"
   },
   "cites": {
