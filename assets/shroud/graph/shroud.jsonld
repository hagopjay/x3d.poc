   "@id": "kb:constant/convention.units",
   "@type": "Quantity",
   "name": "Length unit",
   "tag": "convention",
   "value": "metre",
   "group": "conventions",
   "note": "All lengths in metres unless the unit field says otherwise.",
   "source": {
