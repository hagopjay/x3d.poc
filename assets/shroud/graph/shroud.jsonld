   "@id": "kb:constant/convention.albedo_rule",
   "@type": "Quantity",
   "name": "Albedo from h",
   "tag": "convention",
   "value": "albedo = lerp(LUT row at h=0, LUT row at h=1, h)",
   "group": "conventions",
   "note": "Exact for the JJE model, which is linear in h. Rows are already adapted to D65, so an illuminant's colour lives in the row or in the light, never both.",
   "source": {
    "@id": "kb:doc/plan"
   }
