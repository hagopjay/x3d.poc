                <Shape><Appearance USE='Ribbon'/><Extrusion solid='false' creaseAngle='1.2' beginCap='true' endCap='true' crossSection='-0.004 -0.05, 0.004 -0.05, 0.004 0.05, -0.004 0.05, -0.004 -0.05' spine='-0.04 -0.01 0.05, -0.0675 -0.0177 0.1025, -0.095 -0.0241 0.155, -0.1225 -0.0285 0.2075, -0.15 -0.03 0.26, -0.1775 -0.0285 0.3125, -0.205 -0.0241 0.365, -0.2325 -0.0177 0.4175, -0.26 -0.01 0.47'/></Shape>
                <Transform scale='1 0.75 1'><Shape><Appearance USE='Ribbon'/><Sphere radius='0.075'/></Shape></Transform>
              </Transform></Transform>
            </Transform>
          </Transform>
        </Transform>
        <!-- inner light: warm, dark until the lid lifts -->
        <PointLight DEF='InnerLight' location='0 1.1 0' color='1 0.75 0.4' intensity='0' radius='6' attenuation='0 0 1'/>
        <!-- gold sparks burst out of the box when it opens -->
        <Transform translation='0 0.95 0'>
          <ParticleSystem DEF='Burst' geometryType='SPRITE' particleSize='0.13 0.13' maxParticles='1500' particleLifetime='2.0' lifetimeVariation='0.5' createParticles='false' enabled='true' colorKey='0 0.15 0.6 1'>
            <Appearance alphaMode='BLEND'><UnlitMaterial emissiveColor='1 1 1'><ImageTexture containerField='emissiveTexture' url='"../materials/spark.png"'/></UnlitMaterial></Appearance>
            <ColorRGBA containerField='color' color='1 0.97 0.85 1, 1 0.82 0.42 1, 0.95 0.5 0.15 0.6, 0.53 0.12 0.25 0'/>
            <ConeEmitter containerField='emitter' position='0 0 0' direction='0 1 0' angle='0.95' speed='2.1' variation='0.55' mass='0.1'/>
          </ParticleSystem>
        </Transform>
        <!-- idle motes: a few slow gold flecks rising round the closed box -->
        <Transform translation='0 0.15 0'>
          <ParticleSystem DEF='Motes' geometryType='SPRITE' particleSize='0.035 0.035' maxParticles='60' particleLifetime='5' lifetimeVariation='0.4' colorKey='0 0.2 0.8 1'>
            <Appearance alphaMode='BLEND'><UnlitMaterial emissiveColor='1 1 1'><ImageTexture containerField='emissiveTexture' url='"../materials/spark.png"'/></UnlitMaterial></Appearance>
            <ColorRGBA containerField='color' color='1 0.85 0.5 0, 1 0.85 0.5 0.9, 1 0.7 0.35 0.6, 1 0.6 0.3 0'/>
            <VolumeEmitter containerField='emitter' direction='0 1 0' speed='0.14' variation='0.4' coordIndex='0 1 2 -1 0 2 3 -1 0 3 1 -1 1 3 2 -1'>
              <Coordinate point='-0.95 0 -0.95, 0.95 0 -0.95, 0 0 0.95, 0 0.9 0'/>
            </VolumeEmitter>
          </ParticleSystem>
        </Transform>
        <!-- the gobbler waits inside, scaled to nothing -->
        <Transform DEF='Rise' translation='0 0.3 0' scale='0.0001 0.0001 0.0001'>
          <Transform DEF='Spin'>
            <Transform scale='0.13 0.13 0.13' translation='0.12 0.177 -0.24'>
              <Inline DEF='Gobbler' url='"gobbler.x3d"' load='true'/>
            </Transform>
          </Transform>
        </Transform>
      </Transform>
    </Transform>
    <!-- Mirror image under the floor: the same present, reflected (the floor is 14% see-through). -->
    <Transform scale='1 -1 1' translation='0 -0.02 0'>
      <Transform USE='Idle'/>
    </Transform>
    <!-- ===================== Idle: breathe, sway, glow ===================== -->
    <TimeSensor DEF='IDLE_CLOCK' cycleInterval='5' loop='true'/>
    <PositionInterpolator DEF='Bob' key='0 0.25 0.5 0.75 1' keyValue='0 0.035 0, 0 0.075 0, 0 0.035 0, 0 0.005 0, 0 0.035 0'/>
    <OrientationInterpolator DEF='Sway' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 0.09, 0 1 0 0, 0 1 0 -0.09, 0 1 0 0'/>
    <ScalarInterpolator DEF='GlowPulse' key='0 0.25 0.5 0.75 1' keyValue='0.55 0.25 0.55 0.25 0.55'/>
    <ColorInterpolator DEF='GoldBreath' key='0 0.25 0.5 0.75 1' keyValue='0.015 0.009 0.002, 0.07 0.042 0.012, 0.015 0.009 0.002, 0.07 0.042 0.012, 0.015 0.009 0.002'/>
    <ROUTE fromNode='IDLE_CLOCK' fromField='fraction_changed' toNode='Bob' toField='set_fraction'/>
    <ROUTE fromNode='IDLE_CLOCK' fromField='fraction_changed' toNode='Sway' toField='set_fraction'/>
    <ROUTE fromNode='IDLE_CLOCK' fromField='fraction_changed' toNode='GlowPulse' toField='set_fraction'/>
    <ROUTE fromNode='IDLE_CLOCK' fromField='fraction_changed' toNode='GoldBreath' toField='set_fraction'/>
    <ROUTE fromNode='Bob' fromField='value_changed' toNode='Idle' toField='set_translation'/>
    <ROUTE fromNode='Sway' fromField='value_changed' toNode='Idle' toField='set_rotation'/>
    <ROUTE fromNode='GlowPulse' fromField='value_changed' toNode='PoolMat' toField='set_transparency'/>
    <ROUTE fromNode='GoldBreath' fromField='value_changed' toNode='GoldMat' toField='set_emissiveColor'/>

    <!-- ===================== Open: one 6 s clock drives everything ===================== -->
    <!-- OPEN_CLOCK: the page may also start it through SAI (OPEN_CLOCK.startTime = now). -->
    <TimeSensor DEF='OPEN_CLOCK' cycleInterval='6' loop='false'/>
    <ROUTE fromNode='OpenTouch' fromField='touchTime' toNode='OPEN_CLOCK' toField='set_startTime'/>
    <!-- lid: a little hop, then up and away, spinning, shrinking into the dark -->
    <PositionInterpolator DEF='LidPath' key='0 0.05 0.1 0.16 0.3 0.45 0.62' keyValue='0 1.110 0, 0 1.190 0, 0 1.100 0, 0 1.230 0, 0.55 2.060 -0.25, 1.6 3.010 -1.3, 3.2 3.710 -3.5'/>
    <OrientationInterpolator DEF='LidSpin' key='0 0.12 0.2 0.28 0.36 0.44 0.52 0.62' keyValue='0 1 0 0, 0 1 0 0, 0.3 1 0.2 2.0, 0.3 1 0.2 4.0, 0.3 1 0.2 6.0, 0.3 1 0.2 1.7, 0.3 1 0.2 3.6, 0.3 1 0.2 5.5'/>
    <PositionInterpolator DEF='LidShrink' key='0 0.4 0.62' keyValue='1 1 1, 1 1 1, 0.0001 0.0001 0.0001'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='LidPath' toField='set_fraction'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='LidSpin' toField='set_fraction'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='LidShrink' toField='set_fraction'/>
    <ROUTE fromNode='LidPath' fromField='value_changed' toNode='Lid' toField='set_translation'/>
    <ROUTE fromNode='LidSpin' fromField='value_changed' toNode='LidSpinT' toField='set_rotation'/>
    <ROUTE fromNode='LidShrink' fromField='value_changed' toNode='Lid' toField='set_scale'/>
    <!-- walls fold outward like petals, with a small overshoot and settle -->
    <OrientationInterpolator DEF='FoldFront' key='0 0.12 0.2 0.3 0.4 0.48 0.56 0.64 1' keyValue='1 0 0 0.0000, 1 0 0 0.0000, 1 0 0 0.2500, 1 0 0 0.9000, 1 0 0 1.4000, 1 0 0 1.6000, 1 0 0 1.5200, 1 0 0 1.5500, 1 0 0 1.5500'/>
    <OrientationInterpolator DEF='FoldBack' key='0 0.12 0.2 0.3 0.4 0.48 0.56 0.64 1' keyValue='1 0 0 0.0000, 1 0 0 0.0000, 1 0 0 -0.2500, 1 0 0 -0.9000, 1 0 0 -1.4000, 1 0 0 -1.6000, 1 0 0 -1.5200, 1 0 0 -1.5500, 1 0 0 -1.5500'/>
    <OrientationInterpolator DEF='FoldRight' key='0 0.12 0.2 0.3 0.4 0.48 0.56 0.64 1' keyValue='0 0 1 0.0000, 0 0 1 0.0000, 0 0 1 -0.2500, 0 0 1 -0.9000, 0 0 1 -1.4000, 0 0 1 -1.6000, 0 0 1 -1.5200, 0 0 1 -1.5500, 0 0 1 -1.5500'/>
    <OrientationInterpolator DEF='FoldLeft' key='0 0.12 0.2 0.3 0.4 0.48 0.56 0.64 1' keyValue='0 0 1 0.0000, 0 0 1 0.0000, 0 0 1 0.2500, 0 0 1 0.9000, 0 0 1 1.4000, 0 0 1 1.6000, 0 0 1 1.5200, 0 0 1 1.5500, 0 0 1 1.5500'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='FoldFront' toField='set_fraction'/>
    <ROUTE fromNode='FoldFront' fromField='value_changed' toNode='WallFront' toField='set_rotation'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='FoldBack' toField='set_fraction'/>
    <ROUTE fromNode='FoldBack' fromField='value_changed' toNode='WallBack' toField='set_rotation'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='FoldRight' toField='set_fraction'/>
    <ROUTE fromNode='FoldRight' fromField='value_changed' toNode='WallRight' toField='set_rotation'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='FoldLeft' toField='set_fraction'/>
    <ROUTE fromNode='FoldLeft' fromField='value_changed' toNode='WallLeft' toField='set_rotation'/>
    <!-- sparks: emit between 14% and 30% of the clock -->
    <BooleanSequencer DEF='BurstWindow' key='0 0.14 0.3' keyValue='false true false'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='BurstWindow' toField='set_fraction'/>
    <ROUTE fromNode='BurstWindow' fromField='value_changed' toNode='Burst' toField='set_createParticles'/>
    <!-- once opened, the box sensor switches off (the gobbler keeps its own click-to-dissolve) -->
    <BooleanToggle DEF='Armed' toggle='true'/>
    <ROUTE fromNode='Armed' fromField='toggle_changed' toNode='OpenTouch' toField='set_enabled'/>
    <!-- the camera eases back and up to frame the risen bird -->
    <PositionInterpolator DEF='DollyPos' key='0 0.15 0.45 0.75 1' keyValue='0 1.55 4.7, 0 1.55 4.7, 0 1.75 5.2, 0 1.92 5.65, 0 1.95 5.7'/>
    <OrientationInterpolator DEF='DollyOri' key='0 0.15 0.45 0.75 1' keyValue='1 0 0 -0.2, 1 0 0 -0.2, 1 0 0 -0.17, 1 0 0 -0.155, 1 0 0 -0.155'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='DollyPos' toField='set_fraction'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='DollyOri' toField='set_fraction'/>
    <ROUTE fromNode='DollyPos' fromField='value_changed' toNode='Front' toField='set_position'/>
    <ROUTE fromNode='DollyOri' fromField='value_changed' toNode='Front' toField='set_orientation'/>
    <!-- idle motes pause while the box opens -->
    <BooleanFilter DEF='OnOpen'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='isActive' toNode='OnOpen' toField='set_boolean'/>
    <ROUTE fromNode='OnOpen' fromField='inputNegate' toNode='Motes' toField='set_createParticles'/>
    <ROUTE fromNode='OnOpen' fromField='inputTrue' toNode='Armed' toField='set_boolean'/>
    <!-- inner light flares then settles warm -->
    <ScalarInterpolator DEF='Flare' key='0 0.12 0.2 0.35 0.6 1' keyValue='0 0 6 2.5 0.9 0.9'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='Flare' toField='set_fraction'/>
    <ROUTE fromNode='Flare' fromField='value_changed' toNode='InnerLight' toField='set_intensity'/>
    <!-- the gobbler rises, grows with a soft overshoot, and turns to face us -->
    <PositionInterpolator DEF='RisePath' key='0 0.22 0.4 0.55 0.7 1' keyValue='0 0.3 0, 0 0.3 0, 0 1.0 0, 0 1.33 0, 0 1.22 0, 0 1.25 0'/>
    <PositionInterpolator DEF='RiseScale' key='0 0.22 0.4 0.55 0.7 1' keyValue='0.0001 0.0001 0.0001, 0.0001 0.0001 0.0001, 0.7 0.7 0.7, 1.08 1.08 1.08, 0.98 0.98 0.98, 1 1 1'/>
    <OrientationInterpolator DEF='RiseTurn' key='0 0.22 0.45 0.7 1' keyValue='0 1 0 -3.1, 0 1 0 -3.1, 0 1 0 -1.2, 0 1 0 0.12, 0 1 0 0'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='RisePath' toField='set_fraction'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='RiseScale' toField='set_fraction'/>
    <ROUTE fromNode='OPEN_CLOCK' fromField='fraction_changed' toNode='RiseTurn' toField='set_fraction'/>
    <ROUTE fromNode='RisePath' fromField='value_changed' toNode='Rise' toField='set_translation'/>
    <ROUTE fromNode='RiseScale' fromField='value_changed' toNode='Rise' toField='set_scale'/>
    <ROUTE fromNode='RiseTurn' fromField='value_changed' toNode='Spin' toField='set_rotation'/>
  </Scene>
</X3D>
