<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
    <component name='Lighting' level='3'/>
    <component name='ParticleSystems' level='3'/>
    <meta name='title' content='unwrap.x3d'/>
    <meta name='description' content='Gift 0, Unwrap: a gilded present on a dark mirror floor under warm spotlights. Idle: the box breathes and a gold glow pulses. Click: the lid flies and spins away, the four walls fold open, gold sparks burst and the gobbler (Inline) rises from inside. TimeSensor, interpolators and ROUTEs only, no Script. OPEN_CLOCK can also be started from the page through SAI.'/>
    <meta name='textures' content='All surface textures in ../materials were generated by an image model and made tileable in numpy; glow and spark sprites are procedural.'/>
    <meta name='creator' content='HagopJay'/>
    <meta name='created' content='11 October 2026'/>
  </head>
  <Scene>
    <WorldInfo title='Unwrap'/>
    <Background skyColor='0.012 0.009 0.008'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false' transitionType='"ANIMATE"' transitionTime='1.2'/>
    <Viewpoint DEF='Front' description='The present' position='0 1.55 4.7' orientation='1 0 0 -0.2' centerOfRotation='0 0.8 0' fieldOfView='0.62'/>
    <Viewpoint DEF='Low' description='Low and close' position='1.6 0.55 3.0' orientation='-0.068 0.996 0.054 0.53' centerOfRotation='0 0.8 0' fieldOfView='0.7'/>
    <!-- Three warm spots. The key and rim cast shadows; the fill is soft. -->
    <SpotLight DEF='Key' location='-3.6 4.4 1.8' direction='0.62 -0.74 -0.26' color='1 0.84 0.62' intensity='26' radius='30' beamWidth='0.42' cutOffAngle='0.62' attenuation='1 0 0' shadowIntensity='0.85'/>
    <SpotLight DEF='Rim' location='2.8 3.6 -3.0' direction='-0.56 -0.62 0.6' color='1 0.55 0.25' intensity='22' radius='30' beamWidth='0.35' cutOffAngle='0.6' attenuation='1 0 0' shadowIntensity='0.6'/>
    <SpotLight DEF='Fill' location='3.4 2.2 3.6' direction='-0.66 -0.3 -0.68' color='0.85 0.75 0.95' intensity='6' radius='30' beamWidth='0.6' cutOffAngle='0.9' attenuation='1 0 0'/>
    <DirectionalLight direction='0 -1 -0.2' color='0.6 0.5 0.45' intensity='0.08'/>
    <!-- Night sky: an image-model equirectangular panorama on a large inside-out sphere, dimmed so the gold stays the star. -->
    <Transform rotation='0 1 0 2.2'>
      <Shape>
        <Appearance><UnlitMaterial emissiveColor='0.3 0.25 0.24' emissiveTextureMapping='uv'><ImageTexture containerField='emissiveTexture' url='"../materials/starry_sky.jpg"'/></UnlitMaterial></Appearance>
        <Sphere radius='40' solid='false'/>
      </Shape>
    </Transform>
    <!-- Mirror floor: polished black granite, 14% see-through so the reflected copy below shows. -->
    <Transform DEF='Floor' translation='0 -0.01 0'>
      <Shape>
        <Appearance DEF='FloorApp'>
  <PhysicalMaterial DEF='FloorAppMat' baseColor='0.55 0.5 0.48' metallic='0' roughness='0.12' emissiveColor='0 0 0' transparency='0.14' normalScale='0.5' baseTextureMapping='uv' normalTextureMapping='uv'>
    <ImageTexture containerField='baseTexture' url='"../materials/black_granite.jpg"'/>
    <ImageTexture containerField='normalTexture' url='"../materials/black_granite_normal.png"'/>
  </PhysicalMaterial><TextureTransform DEF='FloorAppTT' scale='22 22'/>
</Appearance>
        <Box size='60 0.02 60'/>
      </Shape>
    </Transform>
    <!-- A warm halo far behind the present: depth and a hint of a sunrise. -->
    <Transform translation='0 1.2 -9'>
      <Billboard axisOfRotation='0 0 0'>
        <Shape>
          <Appearance alphaMode='BLEND'><UnlitMaterial emissiveColor='0.9 0.42 0.2' transparency='0.68' emissiveTextureMapping='uv'><ImageTexture containerField='emissiveTexture' url='"../materials/glow.png"'/></UnlitMaterial></Appearance>
          <IndexedFaceSet solid='false' coordIndex='0 1 2 3 -1' texCoordIndex='0 1 2 3 -1'>
            <Coordinate point='-9 -5 0, 9 -5 0, 9 5 0, -9 5 0'/>
            <TextureCoordinate point='0 0, 1 0, 1 1, 0 1'/>
          </IndexedFaceSet>
        </Shape>
      </Billboard>
    </Transform>
    <!-- Glow pool under the box (procedural sprite), pulsed by IdleGlow. -->
    <Transform translation='0 0.004 0' rotation='1 0 0 -1.5708'>
      <Shape>
        <Appearance alphaMode='BLEND'><UnlitMaterial DEF='PoolMat' emissiveColor='1 0.72 0.35' transparency='0.35' emissiveTextureMapping='uv'><ImageTexture containerField='emissiveTexture' url='"../materials/glow.png"'/></UnlitMaterial></Appearance>
        <IndexedFaceSet solid='false' coordIndex='0 1 2 3 -1' texCoordIndex='0 1 2 3 -1'>
          <Coordinate point='-1.6 -1.6 0, 1.6 -1.6 0, 1.6 1.6 0, -1.6 1.6 0'/>
          <TextureCoordinate point='0 0, 1 0, 1 1, 0 1'/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
