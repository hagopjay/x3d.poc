    </Shape>

    <Transform DEF='Bird' center='0.72 -0.76 0'>
      <!-- A click anywhere on the bird, head or network, starts the Dissolve clock. -->
      <TouchSensor DEF='Touch' description='Dissolve and reassemble'/>
      <!-- Gobble: a short head shake at the start of a click (see GobbleShake). -->
      <Transform DEF='Gobble' center='2.2 -3.4 0'>
        <Group>
          <!-- Gold facets. HeadPoints is the one Coordinate the head's shapes share; FacetShader moves and shades them. -->
          <Shape>
            <Appearance alphaMode='BLEND'>
              <Material DEF='Facets' diffuseColor='0.839 0.702 0.355' emissiveColor='0.07 0.05 0.025' specularColor='0.6 0.48 0.3' shininess='0.35' transparency='0.75'/>
              <ComposedShader DEF='FacetShader' language='GLSL'>
                <field name='phase' type='SFFloat' accessType='inputOutput' value='1'/>
                <field name='time' type='SFTime' accessType='inputOutput' value='0'/>
                <field name='scan' type='SFFloat' accessType='inputOutput' value='-9'/>
                <field name='glow' type='SFFloat' accessType='inputOutput' value='1'/>
                <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform float phase;
uniform float time;
in vec4 x3d_Vertex;
in vec4 x3d_Color;
out vec3 vView;
out vec3 vObj;
flat out vec3 vFacet;
out vec4 vColor;
uvec3 pcg3(uvec3 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  return v;
}
vec3 rnd3i(ivec3 q) { return vec3(pcg3(uvec3(q + 4096))) * (1.0 / 4294967296.0); }
ivec3 qpos(vec3 p) { return ivec3(floor(p * 100.0 + 0.5)); }
vec4 scatter(vec3 p) {
  ivec3 q = qpos(p);
  vec3 r = rnd3i(q);
  vec3 g = (rnd3i(q + ivec3(37, 71, 13)) - 0.5) * 3.4;
  float u = clamp((p.x - -2.75) / (4.79 - -2.75), 0.0, 1.0);
  float jit = (r.x - 0.5) * 0.04;
  float l0 = 0.14 + 0.16 * (1.0 - u) + jit, l1 = l0 + 0.2;
  float b0 = 0.6 + 0.12 * u + jit, b1 = min(0.95, b0 + 0.2);
  if (phase <= l0 || phase >= b1) return vec4(p, 0.0);
  float e, hold;
  if (phase < l1) { e = smoothstep(l0, l1, phase); hold = 0.0; }
  else if (phase <= b0) { e = 1.0; hold = (phase - l1) / max(1e-4, b0 - l1); }
  else { e = 1.0 - smoothstep(b0, b1, phase); hold = 1.0; }
  float s = e < 1.0 ? sin(3.14159265 * e) : 0.0;
  const float c = 0.97030, sn = -0.24188;
  vec2 d = vec2((p.x - 0.45) * 1.6, (p.y + 0.75) * 1.5);
  vec3 tgt = vec3(2.5 + d.x * c - d.y * sn + g.x * 0.36, -0.9 + d.x * sn + d.y * c + g.y * 0.36, 1.2 * p.z + g.z * 0.9);
  vec3 curl = vec3(0.0, 0.6 * sin(2.1 * p.x + 0.5), 0.6 * cos(1.7 * p.y));
  vec3 drift = vec3(0.3 + 0.1 * sin(3.0 * p.y), 0.12 * sin(2.0 * p.x), 0.15 * cos(2.0 * p.y));
  vec3 live = 0.07 * e * vec3(sin(time * 0.9 + r.y * 6.283), cos(time * 0.7 + r.z * 6.283), sin(time * 0.5 + r.x * 6.283));
  return vec4(p + (tgt - p) * e + curl * s + drift * hold * e + live, e);
}
void main() {
  vec4 s = scatter(x3d_Vertex.xyz);
  vec4 mv = x3d_ModelViewMatrix * vec4(s.xyz, 1.0);
  vView = mv.xyz;
  vObj = x3d_Vertex.xyz;
  vFacet = x3d_Vertex.xyz;                                      // flat: one corner's rest position for the whole facet
  vColor = x3d_Color;
  gl_Position = x3d_ProjectionMatrix * mv;
}
]]></ShaderPart>
                <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
uniform float phase;
uniform float time;
uniform float scan;
uniform float glow;
in vec3 vView;
in vec3 vObj;
flat in vec3 vFacet;
in vec4 vColor;
out vec4 x3d_FragColor;
uvec3 pcg3(uvec3 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  return v;
}
vec3 rnd3i(ivec3 q) { return vec3(pcg3(uvec3(q + 4096))) * (1.0 / 4294967296.0); }
ivec3 qpos(vec3 p) { return ivec3(floor(p * 100.0 + 0.5)); }
float h1(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x) {
  vec3 i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(h1(i), h1(i + vec3(1, 0, 0)), f.x), mix(h1(i + vec3(0, 1, 0)), h1(i + vec3(1, 1, 0)), f.x), f.y),
             mix(mix(h1(i + vec3(0, 0, 1)), h1(i + vec3(1, 0, 1)), f.x), mix(h1(i + vec3(0, 1, 1)), h1(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
void main() {
  vec3 N = normalize(cross(dFdx(vView), dFdy(vView)));      // flat, per facet
  vec3 V = normalize(-vView);
  float NdV = dot(N, V);
  if (NdV < 0.0) { N = -N; NdV = -NdV; }
  // One set of random numbers per facet, keyed on the facet's own colour (constant across the facet).
  ivec4 cq = ivec4(floor(vColor * 1000.0 + 0.5));
  vec3 fr = rnd3i(cq.xyz + ivec3(cq.w, 2 * cq.w, 3 * cq.w));
  vec3 fr2 = rnd3i(cq.zxy + ivec3(91, 17, 53));
  float fid = fr.x;
  // The click: the head burns away facet by facet, nape first, and burns back in nape first too. When a facet goes
  // is set by where it sits (one flat corner, so the whole triangle moves as one) plus its own random offset; a fine
  // noise rim, white-hot to gold to maroon, crawls across each facet in the moment it burns.
  float u = clamp((vObj.x - -2.75) / (4.79 - -2.75), 0.0, 1.0);
  float uf = clamp((vFacet.x - -2.75) / (4.79 - -2.75), 0.0, 1.0);
  float d = phase < 0.6 ? clamp((phase - 0.07) / 0.22, 0.0, 1.0) : 1.0 - clamp((phase - 0.77) / 0.2, 0.0, 1.0);
  float edge = 1.0, edgeF = 1.0;
  if (d > 0.0) {
    float kf = (phase < 0.6 ? 1.0 - uf : uf) * 0.8 + (fid - 0.5) * 0.14;   // one value per facet
    float uu = mix(uf, u, 0.35);
    float n = vnoise(vObj * 7.0) * 0.6 + vnoise(vObj * 17.0 + 3.1) * 0.4;
    float k = (phase < 0.6 ? 1.0 - uu : uu) * 0.8 + (fid - 0.5) * 0.14 + (n - 0.5) * 0.035;
    edge = k - d * 1.3 + 0.15;
    edgeF = kf - d * 1.3 + 0.15 + 0.035;
    if (edge < 0.0) discard;
  }
  float burn = 1.0 - smoothstep(0.0, 0.02, edge);
  float flare = 1.0 - smoothstep(0.0, 0.06, edgeF);              // the whole facet heats up just before it goes
  // Gold: Fresnel over a procedural studio (key softbox, strip light, horizon line, top fill).
  vec3 base = vColor.rgb;
  float flesh = clamp((base.r - base.g - 0.22) * 3.0, 0.0, 1.0);
  vec3 Ne = normalize(N + (fr - 0.5) * 0.22);                   // a mosaic of facets
  vec3 R = reflect(-V, Ne);
  float key = smoothstep(0.62, 0.96, dot(R, normalize(vec3(-0.45, 0.6, 0.66))));
  float key2 = smoothstep(0.82, 0.98, dot(R, normalize(vec3(0.55, 0.5, 0.67))));
  float strip = exp(-pow((R.x - 0.72) * 5.0, 2.0)) * smoothstep(-0.4, 0.4, R.y);
  float fill = smoothstep(0.55, 1.0, dot(R, normalize(vec3(0.25, -0.25, 0.93))));
  float hor = exp(-pow(R.y * 5.5 + 0.35, 2.0));
  float top = smoothstep(0.3, 1.0, R.y);
  vec3 env = vec3(1.0, 0.9, 0.74) * (key * 2.1 + key2 * 1.3) + vec3(1.0, 0.7, 0.4) * (strip * 0.9 + fill * 0.28)
           + vec3(0.95, 0.6, 0.3) * hor * 0.5 + vec3(0.5, 0.42, 0.34) * top * 0.25 + vec3(0.035, 0.026, 0.02);
  vec3 F0 = clamp(base * vec3(1.2, 1.0, 0.72) * (0.75 + 0.5 * fid), 0.0, 1.0);
  vec3 F = F0 + (1.0 - F0) * pow(1.0 - NdV, 5.0);
  vec3 metal = F * env;
  vec3 L = normalize(vec3(-0.5, 0.6, 0.62));
  float dif = max(dot(N, L), 0.0);
  float spec = pow(max(dot(N, normalize(L + V)), 0.0), 70.0);
  vec3 skin = base * (0.16 + 0.75 * dif) + vec3(1.0, 0.86, 0.8) * spec * 0.6 + base * strip * 0.45;
  vec3 col = mix(metal, skin, flesh);
  float rim = pow(1.0 - NdV, 3.0);                             // Hokie maroon to ember at the edges
  col += mix(vec3(0.55, 0.08, 0.17), vec3(1.0, 0.46, 0.12), clamp(0.55 + vObj.y * 0.28, 0.0, 1.0)) * rim * 0.85;
  vec3 Np = normalize(N + (fr2 - 0.5) * 0.3);
  float glint = pow(max(dot(reflect(-V, Np), normalize(vec3(-0.45, 0.65, 0.6))), 0.0), 160.0);
  float flash = step(0.9, fid) * pow(0.5 + 0.5 * sin(time * (1.1 + 2.0 * fid) + fid * 40.0), 40.0);
  col += vec3(1.0, 0.93, 0.78) * (glint * 1.5 + flash * 1.3) * (1.0 - 0.6 * flesh) * glow;
  float sc = exp(-pow((vObj.x * 0.85 + vObj.y * 0.3 - scan) * 2.4, 2.0));   // the energy scan
  col += (vec3(1.0, 0.66, 0.26) * 0.45 + vec3(1.0, 0.9, 0.7) * rim * 0.9) * sc * glow;
  col = mix(col, vec3(0.95, 0.42, 0.1) * 0.75 + col * 0.35, flare * flare * 0.7);          // heating: toward ember
  vec3 hot = mix(vec3(0.5, 0.07, 0.1), vec3(1.0, 0.64, 0.2), smoothstep(0.0, 0.55, burn));   // the rim: maroon to gold
  hot = mix(hot, vec3(1.0, 0.96, 0.86), smoothstep(0.72, 1.0, burn));                          // to white-hot
  col += hot * burn * 1.25;
  // Highlights roll off without a hue shift: clipping each channel on its own turned bright gold lime.
  float m = max(max(col.r, col.g), col.b);
  col /= 1.0 + m * 0.12;
  m = max(max(col.r, col.g), col.b);
  if (m > 1.0) col = mix(col / m, vec3(1.0, 0.93, 0.8), clamp((m - 1.0) * 0.45, 0.0, 0.55));
  col *= 1.0;                                                 // extras: gold peaks near 0.93, under the glow layers
  float a = clamp(vColor.a + rim * 0.2 + burn + flare * 0.3 + sc * 0.15, 0.0, 1.0);
  x3d_FragColor = vec4(col, a);
}
]]></ShaderPart>
              </ComposedShader>
            </Appearance>
