          4.42 0.21 -5.78 -0.73 -6.57 -5.42 -4.98 0.6 -9.37 6.44 2.34 -5.55 5.44 -4.4 2.35 0.59 -6.38 -3.85 6.57 -3.88 1.25 -7.67 1.06 -6.22
