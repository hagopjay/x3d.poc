          0.01 0.54 2.66 9.18 -0.99 -0.03 -0.58 -1.64 -1.93 1.29 -0.88 -5.04 -5.04 -5.95 -5.16 5.08 4.17 -1.53 -7.95 4.54 -5.57 1.97 -3.06 -2.32
