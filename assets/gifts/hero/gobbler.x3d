          10.3 -4.88 -7.99 7.85 3.56 -8.52 -4.51 0.27 -8.02 8.25 -2.96 -4.69 7.56 4.74 -6.05 2.02 -0.29 -2.05 3.9 0.68 2.76 -4.94 -2.55 -6.81
          0.79 -4.52 -4.68 -1.53 -4.82 1.47 -0.4 -4.13 -1.36 3.57 -4.09 -1.11 -4.49 -5.72 -5.07 3.59 -4.77 -5.13 3.9 -6.92 -6.93 3.66 0.98 -2.09
          -2.34 -4.15 -6.15 1.23 -2.35 -1.99 1.18 -2.11 -1.37 -0.11 -2.54 -7.58 -1.78 3.96 -3.77 7.62 -6.95 -6.85 7.94 -1.48 -0.95 3.25 1.69 -0.84
          -0.12 3.29 0.64 5.95 -4.32 -3.76 -4.61 0.39 -0.13 0.01 0.81 -0.11 5.87 -3.73 0.54 -7.11 1.04 2.38 -7.94 -0.24 -9.21 8.67 2.75 -3.05
