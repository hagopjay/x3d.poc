          -6.59 1.97 -0.04 5.41 -5.03 -4.97 -5.22 -2.49 1.99 3.85 -1.29 -4.04 0.39 4.15 -3.55 3.74 1.6 -8.5 3.38 -5.07 -3.44 -3.02 -2.95 -1.43
          2.06 -6.14 1 0.68 2.19 -8.07 5.28 2.31 -8.6 -7.4 4.41 -9.76 7.49 -4.89 0.07 6.95 3.37 -6.69 1.84 -1.08 -3.85 3.12 -1.07 1.5
          -5.18 2.91 -1.88 -2.42 -6.98 0.72 -0.29 3.97 -6.88 -6.12 -6.31 2.11 10.24 3.31 -3.97 -7.63 4.89 -2.93 -6.05 -4.18 2.55 10.4 -0.94 -5.88
