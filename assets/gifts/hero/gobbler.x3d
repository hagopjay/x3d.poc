          <!-- Edges as glowing ribbons, one quad per edge: coordIndex is this end, texCoordIndex (into a copy of
               HeadPoints) the other end, normalIndex picks the corner's code from RibbonCodes. LineShader widens them. -->
          <!-- bboxCenter sits in front of the facets' centre so X_ITE draws the glow layers after the gold. -->
          <Shape bboxCenter='1.02 -1.36 1.6' bboxSize='15.78 16.54 9.46'>
            <Appearance alphaMode='BLEND'>
              <Material diffuseColor='0 0 0' emissiveColor='0.839 0.702 0.355'/>
              <ComposedShader DEF='LineShader' language='GLSL'>
                <field name='phase' type='SFFloat' accessType='inputOutput' value='1'/>
                <field name='time' type='SFTime' accessType='inputOutput' value='0'/>
                <field name='scan' type='SFFloat' accessType='inputOutput' value='-9'/>
                <field name='glow' type='SFFloat' accessType='inputOutput' value='1'/>
                <field name='bloom' type='SFFloat' accessType='inputOutput' value='0'/>
                <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform ivec4 x3d_Viewport;
uniform float phase;
uniform float time;
uniform float scan;
uniform float bloom;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in vec4 x3d_TexCoord0;
in vec4 x3d_Color;
out vec4 vColor;
out float vX;
out float vS;
out float vPulse;
out float vSeed;
out float vFade;
out float vScan;
out float vBloom;
uvec3 pcg3(uvec3 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  return v;
}
vec3 rnd3i(ivec3 q) { return vec3(pcg3(uvec3(q + 4096))) * (1.0 / 4294967296.0); }
ivec3 qpos(vec3 p) { return ivec3(floor(p * 100.0 + 0.5)); }
vec4 scatter(vec3 p) {
  ivec3 q = qpos(p);
  vec3 r = rnd3i(q);
  vec3 g = (rnd3i(q + ivec3(37, 71, 13)) - 0.5) * 3.4;
  float u = clamp((p.x - -2.75) / (4.79 - -2.75), 0.0, 1.0);
  float jit = (r.x - 0.5) * 0.04;
  float l0 = 0.14 + 0.16 * (1.0 - u) + jit, l1 = l0 + 0.2;
  float b0 = 0.6 + 0.12 * u + jit, b1 = min(0.95, b0 + 0.2);
  if (phase <= l0 || phase >= b1) return vec4(p, 0.0);
  float e, hold;
  if (phase < l1) { e = smoothstep(l0, l1, phase); hold = 0.0; }
  else if (phase <= b0) { e = 1.0; hold = (phase - l1) / max(1e-4, b0 - l1); }
  else { e = 1.0 - smoothstep(b0, b1, phase); hold = 1.0; }
  float s = e < 1.0 ? sin(3.14159265 * e) : 0.0;
  const float c = 0.97030, sn = -0.24188;
  vec2 d = vec2((p.x - 0.45) * 1.6, (p.y + 0.75) * 1.5);
  vec3 tgt = vec3(2.5 + d.x * c - d.y * sn + g.x * 0.36, -0.9 + d.x * sn + d.y * c + g.y * 0.36, 1.2 * p.z + g.z * 0.9);
  vec3 curl = vec3(0.0, 0.6 * sin(2.1 * p.x + 0.5), 0.6 * cos(1.7 * p.y));
  vec3 drift = vec3(0.3 + 0.1 * sin(3.0 * p.y), 0.12 * sin(2.0 * p.x), 0.15 * cos(2.0 * p.y));
  vec3 live = 0.07 * e * vec3(sin(time * 0.9 + r.y * 6.283), cos(time * 0.7 + r.z * 6.283), sin(time * 0.5 + r.x * 6.283));
  return vec4(p + (tgt - p) * e + curl * s + drift * hold * e + live, e);
}
void main() {
  int code = (int(floor(atan(x3d_Normal.y, x3d_Normal.x) / 0.39269908 + 0.5)) + 16) % 16;
  float side = (code & 1) == 1 ? 1.0 : -1.0;
  vec3 a = x3d_Vertex.xyz, b = x3d_TexCoord0.xyz;
  vec4 sa = (code & 4) != 0 ? vec4(a, 0.0) : scatter(a);
  vec4 sb = (code & 8) != 0 ? vec4(b, 0.0) : scatter(b);
  mat4 PM = x3d_ProjectionMatrix * x3d_ModelViewMatrix;
  vec4 ca = PM * vec4(sa.xyz, 1.0), cb = PM * vec4(sb.xyz, 1.0);
  vec2 vp = vec2(x3d_Viewport.zw);
  vec2 dir = cb.xy / cb.w * vp - ca.xy / ca.w * vp;
  float len = length(dir);
  dir = len > 1e-5 ? dir / len : vec2(1.0, 0.0);
  float bl = bloom * ((code & 12) != 0 ? 1.0 : 0.45);           // less bloom on the head's dense lattice
  float w = (0.6 + 2.8 * x3d_Color.a) * (1.0 + 1.6 * bl) * vp.y / 640.0;   // half width in pixels, scaled with the canvas
  ca.xy += vec2(-dir.y, dir.x) * side * w * 2.0 / vp * ca.w;
  ca.z -= 0.002 * ca.w;                                         // sit just in front of the facets
  gl_Position = ca;
  vBloom = bl;
  vX = (code & 2) != 0 ? -side : side;                          // across the ribbon, the same sign at both ends
  vColor = x3d_Color;
  vS = a.x >= b.x ? 0.0 : 1.0;                                  // pulses run from the far end toward the head
  vPulse = (code & 12) != 0 ? 1.0 : 0.0;
  vSeed = rnd3i(qpos(a) + qpos(b)).x;
  vFade = 1.0 - 0.55 * max(sa.w, sb.w);
  vScan = (code & 12) != 0 ? 0.0 : exp(-pow(((a.x + b.x) * 0.425 + (a.y + b.y) * 0.15 - scan) * 2.4, 2.0));
}
]]></ShaderPart>
                <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
uniform float time;
uniform float glow;
in float vBloom;
in vec4 vColor;
in float vX;
in float vS;
in float vPulse;
in float vSeed;
in float vFade;
in float vScan;
out vec4 x3d_FragColor;
void main() {
  float b = 1.0 + 1.6 * vBloom;                                 // bloom widens the ribbon, the core keeps its width
  float core = exp(-vX * vX * 9.0 * b * b);
  float halo = (exp(-vX * vX * 2.2 * b) * (0.3 - 0.12 * vBloom) + exp(-vX * vX * 3.0) * 0.1 * vBloom) * 1.0;
  float pk = 0.0;
  if (vPulse > 0.5) {
    float t = fract(time * (0.09 + 0.13 * vSeed) + vSeed * 17.0) * 1.8 - 0.4;
    float dd = vS - t;
    pk = exp(-dd * dd * 60.0) * glow;
  }
  vec3 em = vColor.rgb * (core * 1.1 + halo) + vec3(1.0, 0.85, 0.55) * pk * (core * 1.7 + halo * 2.2)
          + vec3(1.0, 0.74, 0.38) * vScan * (core + halo) * 1.3 * glow;
  em *= vFade * (vPulse > 0.5 ? 1.0 : 1.0);                   // 1.0: the head's dense lattice, dimmer when additive
  float a = clamp(max(max(em.r, em.g), em.b), 0.0, 1.0);
  if (a < 0.004) discard;
  x3d_FragColor = vec4(min(em / max(a, 1e-3), vec3(1.0)), a);
}
]]></ShaderPart>
