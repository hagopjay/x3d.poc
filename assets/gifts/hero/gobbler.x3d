          1.18 0.25 -6.46 2.47 1.3 -0.22 -5.14 -3.2 2.88 4.09 -2.24 -0.45 1.52 -6.52 0.59 -3.98 -1.61 -4.28 -7.04 -4.15 -8.48 -7.73 2.72 -7.98
