<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D version="4.0" profile="Immersive" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shaders" level="1"/>
    <component name="ParticleSystems" level="3"/>
    <component name="Shape" level="2"/>
    <meta name="title" content="Pantheon stage, light layer"/>
    <meta name="description" content="Sky glowing in the oculus, a shaft of sun from it, the pool it makes on the floor, and dust in the light, for the Pantheon stage of PolyXandria First Light. Stage dressing only: it is drawn over the splats and does not change the evidence file."/>
    <meta name="x3d-build" content="Standard X3D 4.0 nodes only (ComposedShader, ParticleSystem, UnlitMaterial), alpha blended."/>
    <meta name="generator" content="gen_stage.py (First Light v2, Pantheon stage)"/>
  </head>
  <Scene>
    <!-- The clocks and the dust start asleep (stopTime 1, enabled false), so nothing animates while the splats load.
         The stage IMPORTs LightClock, SunClock and Dust, and the page wakes them (startTime, enabled) when the splats
         are in. A reduced-motion visitor keeps them asleep; the glow, the shaft and the pool still draw, unmoving. -->
    <TimeSensor DEF="LightClock" cycleInterval="3600" loop="true" stopTime="1"/>
    <TimeSensor DEF="SunClock" cycleInterval="150" loop="true" stopTime="1"/>
    <OrientationInterpolator DEF="SunDrift" key="0 0.25 0.5 0.75 1" keyValue="0 1 0 0  0 1 0 0.14  0 1 0 0  0 1 0 -0.14  0 1 0 0"/>
    <Transform DEF="Halo" translation="-3.5 19.55 -3.9">
      <Shape bboxCenter="3.5 -19.55 3.9" bboxSize="400 400 400">
        <Appearance alphaMode="BLEND">
          <UnlitMaterial emissiveColor="1 0.97 0.9" transparency="0.3"/>
          <ComposedShader DEF="HaloShader" language="GLSL">
              <field name="elapsed" type="SFTime" accessType="inputOutput" value="0"/>
              <field name="intensity" type="SFFloat" accessType="inputOutput" value="0.85"/>
              <field name="tint" type="SFColor" accessType="inputOutput" value="1 0.88 0.64"/>
              <field name="hole" type="SFFloat" accessType="inputOutput" value="0.4348"/>
              <ShaderPart type="VERTEX"><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in vec4 x3d_TexCoord0;
out vec3 vN;
out vec3 vP;
out vec2 vT;
out vec3 vA;
void main() {
  vec4 mv = x3d_ModelViewMatrix * x3d_Vertex;
  vA = (x3d_ModelViewMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
  vP = mv.xyz;
  vN = x3d_NormalMatrix * x3d_Normal;
  vT = x3d_TexCoord0.st;
  gl_Position = x3d_ProjectionMatrix * mv;
}
]]></ShaderPart>
              <ShaderPart type="FRAGMENT"><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform float elapsed;
uniform float intensity;
uniform vec3 tint;
uniform float hole;
in vec3 vN;
in vec3 vP;
in vec2 vT;
out vec4 x3d_FragColor;
void main() {
  float r = length(vT - vec2(0.5)) * 2.0;
  float sky = 1.0 - smoothstep(hole * 0.78, hole * 1.02, r);
  float g = 1.0 - smoothstep(hole * 0.85, 1.0, r);
  float bloom = g * g * sqrt(g);
  float a = intensity * (0.0 * sky + 0.2 * bloom) * (0.985 + 0.015 * sin(elapsed * 0.31));
  x3d_FragColor = vec4(mix(tint, vec3(1.0, 0.98, 0.93), sky), clamp(a, 0.0, 1.0));
}
]]></ShaderPart>
            </ComposedShader>
        </Appearance>
        <Cylinder radius="6.440" height="0.01" side="false" top="false"/>
      </Shape>
    </Transform>
    <!-- Sun swings about the oculus axis (center), so the shaft stays in the oculus and its pool walks the floor. -->
    <Transform DEF="Sun" center="-3.5 0 -3.9">
      <Transform DEF="Shaft" translation="-3.5 8.6352 -7.7453" rotation="1 0 0 0.34907">
        <Shape bboxCenter="3.5 -5.4654 10.2316" bboxSize="400 400 400">
          <Appearance alphaMode="BLEND">
            <UnlitMaterial emissiveColor="1 0.94 0.82" transparency="0.75"/>
            <ComposedShader DEF="ShaftShader" language="GLSL">
              <field name="elapsed" type="SFTime" accessType="inputOutput" value="0"/>
              <field name="intensity" type="SFFloat" accessType="inputOutput" value="2.2"/>
              <field name="tint" type="SFColor" accessType="inputOutput" value="1 0.88 0.64"/>
              <ShaderPart type="VERTEX"><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in vec4 x3d_TexCoord0;
out vec3 vN;
out vec3 vP;
out vec2 vT;
out vec3 vA;
void main() {
  vec4 mv = x3d_ModelViewMatrix * x3d_Vertex;
  vA = (x3d_ModelViewMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
  vP = mv.xyz;
  vN = x3d_NormalMatrix * x3d_Normal;
  vT = x3d_TexCoord0.st;
  gl_Position = x3d_ProjectionMatrix * mv;
}
]]></ShaderPart>
              <ShaderPart type="FRAGMENT"><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform float elapsed;
uniform float intensity;
uniform vec3 tint;
in vec3 vN;
in vec3 vP;
in vec2 vT;
in vec3 vA;
out vec4 x3d_FragColor;
void main() {
  vec3 v = normalize(-vP);
  float facing = max(dot(normalize(vN), v), 0.0);
  float body = pow(smoothstep(0.3, 1.0, facing), 1.5);
  float side = pow(1.0 - abs(dot(normalize(vA), v)), 1.5);
  float t = vT.t;
  float ends = smoothstep(0.0, 0.06, t) * (1.0 - smoothstep(0.96, 1.0, t));
  float a1 = vT.s * 6.2831853;
  float streak = 0.65 + 0.35 * (0.6 * sin(a1 * 7.0 + sin(t * 5.0 - elapsed * 0.11) * 1.2)
                           + 0.4 * sin(a1 * 17.0 - elapsed * 0.05 + t * 3.0));
  float motes = 0.93 + 0.07 * sin(t * 61.0 - elapsed * 0.9 + a1 * 11.0);
  float core = smoothstep(0.85, 0.99, t);
  float a = intensity * ends * side * body * ((0.55 + 0.45 * t) * streak * motes + 0.25 * core);
  x3d_FragColor = vec4(tint, 0.6 * (1.0 - exp(-max(a, 0.0) / 0.6)));
}
]]></ShaderPart>
            </ComposedShader>
          </Appearance>
          <Cylinder radius="2.8" height="22.486" top="false" bottom="false"/>
        </Shape>
        <ParticleSystem DEF="Dust" enabled="false" geometryType="SPRITE" maxParticles="216" particleLifetime="9" lifetimeVariation="0.4"
                        particleSize="0.24 0.24" colorKey="0 0.25 0.75 1" bboxCenter="3.5 -5.4654 10.2316" bboxSize="400 400 400">
          <Appearance alphaMode="BLEND">
            <UnlitMaterial emissiveColor="1 1 1"/>
            <ImageTexture url='"pantheon-stage-mote.png"'/>
          </Appearance>
          <ColorRGBA color="1 0.84 0.56 0  1 0.82 0.52 0.9  1 0.78 0.46 0.72  1 0.74 0.4 0"/>
          <VolumeEmitter direction="0 0 0" speed="0.035" variation="1" coordIndex="7 6 5 4 3 2 1 0 -1 8 9 10 11 12 13 14 15 -1 0 8 9 1 -1 1 9 10 2 -1 2 10 11 3 -1 3 11 12 4 -1 4 12 13 5 -1 5 13 14 6 -1 6 14 15 7 -1 7 15 8 0 -1">
            <Coordinate point="1.4 -9.444 0 0.9899 -9.444 0.9899 0 -9.444 1.4 -0.9899 -9.444 0.9899 -1.4 -9.444 0 -0.9899 -9.444 -0.9899 0 -9.444 -1.4 0.9899 -9.444 -0.9899 1.4 9.444 0 0.9899 9.444 0.9899 0 9.444 1.4 -0.9899 9.444 0.9899 -1.4 9.444 0 -0.9899 9.444 -0.9899 0 9.444 -1.4 0.9899 9.444 -0.9899"/>
          </VolumeEmitter>
        </ParticleSystem>
      </Transform>
      <Transform DEF="Pool" translation="-3.5 -1.3158 -11.3853" rotation="1 0 0 -0.06421">
        <Transform scale="1 1 1.0642">
          <Shape bboxCenter="3.5 0.5825 10.756" bboxSize="400 400 400">
            <Appearance alphaMode="BLEND">
              <UnlitMaterial emissiveColor="1 0.95 0.85" transparency="0.5"/>
              <ComposedShader DEF="PoolShader" language="GLSL">
              <field name="elapsed" type="SFTime" accessType="inputOutput" value="0"/>
              <field name="intensity" type="SFFloat" accessType="inputOutput" value="0.6"/>
              <field name="tint" type="SFColor" accessType="inputOutput" value="1 0.9 0.7"/>
              <ShaderPart type="VERTEX"><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in vec4 x3d_TexCoord0;
out vec3 vN;
out vec3 vP;
out vec2 vT;
out vec3 vA;
void main() {
  vec4 mv = x3d_ModelViewMatrix * x3d_Vertex;
  vA = (x3d_ModelViewMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
  vP = mv.xyz;
  vN = x3d_NormalMatrix * x3d_Normal;
  vT = x3d_TexCoord0.st;
  gl_Position = x3d_ProjectionMatrix * mv;
}
]]></ShaderPart>
              <ShaderPart type="FRAGMENT"><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform float elapsed;
uniform float intensity;
uniform vec3 tint;
in vec3 vN;
in vec3 vP;
in vec2 vT;
out vec4 x3d_FragColor;
void main() {
  float r = length(vT - vec2(0.5)) * 2.0;
  float pool = 1.0 - smoothstep(0.1, 1.0, r);
  float a = intensity * pool * pool * (0.95 + 0.05 * sin(elapsed * 0.5 + r * 5.0));
  x3d_FragColor = vec4(tint, clamp(a, 0.0, 0.3));
}
]]></ShaderPart>
            </ComposedShader>
            </Appearance>
            <Cylinder radius="3.360" height="0.01" side="false" bottom="false"/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <ROUTE fromNode="LightClock" fromField="elapsedTime" toNode="ShaftShader" toField="elapsed"/>
    <ROUTE fromNode="LightClock" fromField="elapsedTime" toNode="PoolShader" toField="elapsed"/>
    <ROUTE fromNode="LightClock" fromField="elapsedTime" toNode="HaloShader" toField="elapsed"/>
    <ROUTE fromNode="SunClock" fromField="fraction_changed" toNode="SunDrift" toField="set_fraction"/>
    <ROUTE fromNode="SunDrift" fromField="value_changed" toNode="Sun" toField="set_rotation"/>
    <EXPORT localDEF="LightClock"/>
    <EXPORT localDEF="SunClock"/>
    <EXPORT localDEF="Dust"/>
  </Scene>
</X3D>
