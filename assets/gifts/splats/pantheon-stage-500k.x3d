<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.1//EN" "https://www.web3d.org/specifications/x3d-4.1.dtd">
<X3D version="4.1" profile="Immersive" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.1.xsd">
  <head>
    <component name="GaussianSplats" level="1"/>
    <component name="EnvironmentalEffects" level="3"/>
    <component name="EventUtilities" level="1"/>
    <meta name="title" content="Pantheon stage, all 500,000 splats"/>
    <meta name="description" content="A stage for the Gaussian splat Pantheon in PolyXandria First Light. It adds a backdrop, viewpoints, a slow camera tour and a light layer around the evidence file, which it Inlines without changing a byte."/>
    <meta name="evidence" content="The evidence Inline starts with load set to false. pantheon-full-500k-x3d41.x3d is the text inside the two base64 parts pantheon-full-500k-x3d41.x3dz.b64-1of2.txt and -2of2.txt (14.6 MB of gzip, 65 MB of X3D), which this host cannot serve as one file. The page decodes the parts, inflates them in the browser, puts the children of the Scene of that file, byte for byte, in a Group with DEF Evidence in place of this Inline and loads the result as one scene. Any X3D browser can instead point this Inline at the inflated text and set load to true."/>
    <meta name="backdrop" content="The TextureBackground faces are the same splats rendered by X_ITE 16.4.3 from the viewpoint on black and on white, combined to undo the splats' own transparency and blurred (about 2 degrees). Where the splats thin out, the room's own blurred light shows instead of a void."/>
    <meta name="light" content="The light layer is an Inline (pantheon-stage-light.x3d, standard; pantheon-stage-light-xite.x3d, X_ITE extras). It starts with load set to false so it costs nothing while the splats load. It EXPORTs LightClock, SunClock and Dust, which start asleep; this stage IMPORTs them. Once the splats are in, the page picks the build, sets load to true and wakes the three nodes."/>
    <meta name="viewpoints" content="Oculus and PantheonEye copy the evidence file's two cameras (CA_Oculus, CA_PantheonEye), which sit inside Transforms and are not EXPORTed. Tour is a slow loop driven by interpolators that opens on the Oculus view, holds it for 5 s, comes down to eye level toward the doors, walks round the rotunda and rises back to the oculus. Its clock starts when Tour is first bound. It pauses when another viewpoint is bound (Tour.isBound FALSE, BooleanFilter inputNegate TRUE, TimeTrigger, pauseTime; X_ITE 16.4.3 fires TimeTrigger only on TRUE in X3D 4 scenes) and resumes when Tour is bound again."/>
    <meta name="generator" content="gen_stage.py (First Light v2, Pantheon stage)"/>
  </head>
  <Scene>
    <NavigationInfo headlight="false" type='"EXAMINE" "ANY"' transitionType='"ANIMATE"' transitionTime="2.5"/>
    <TextureBackground DEF="Backdrop">
      <ImageTexture containerField="frontTexture" url='"gifts/splats/pantheon-stage-bd500-front.jpg"' repeatS="false" repeatT="false"/>
      <ImageTexture containerField="backTexture" url='"gifts/splats/pantheon-stage-bd500-back.jpg"' repeatS="false" repeatT="false"/>
      <ImageTexture containerField="leftTexture" url='"gifts/splats/pantheon-stage-bd500-left.jpg"' repeatS="false" repeatT="false"/>
      <ImageTexture containerField="rightTexture" url='"gifts/splats/pantheon-stage-bd500-right.jpg"' repeatS="false" repeatT="false"/>
      <ImageTexture containerField="topTexture" url='"gifts/splats/pantheon-stage-bd500-top.jpg"' repeatS="false" repeatT="false"/>
      <ImageTexture containerField="bottomTexture" url='"gifts/splats/pantheon-stage-bd500-bottom.jpg"' repeatS="false" repeatT="false"/>
    </TextureBackground>
    <Viewpoint DEF="Oculus" description="Up at the oculus" position="0 0 0" orientation="1 0 0 1.570796" fieldOfView="1.570796"/>
    <Viewpoint DEF="PantheonEye" description="Toward the doors" position="0 0 0" orientation="0 0 1 0" fieldOfView="1.22173"/>
    <Viewpoint DEF="Tour" description="Slow tour" position="0 0 0" orientation="1 0 0 1.5708" fieldOfView="1.5708"/>
