<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
    <component name='Lighting' level='3'/>
    <meta name='title' content='materials.x3d'/>
    <meta name='description' content='Gift 5, Materials from nothing: a swatch shelf of eight PhysicalMaterial samples on a walnut plinth under a starry sky. Every albedo was generated by an image model; height and roughness maps were generated from those albedos or derived in numpy, and every normal map was derived in numpy (Sobel). Swatches turn slowly (TimeSensor, OrientationInterpolator, ROUTE; no Script).'/>
    <meta name='creator' content='HagopJay'/>
    <meta name='created' content='11 October 2026'/>
  </head>
  <Scene>
    <WorldInfo title='Materials from nothing'/>
    <Background skyColor='0.012 0.009 0.008'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint DEF='Shelf' description='Swatch shelf' position='0 2.0 7.0' orientation='1 0 0 -0.2' centerOfRotation='0 0.75 0' fieldOfView='0.62'/>
    <Viewpoint DEF='Close' description='Close' position='-1.3 1.05 2.6' orientation='0 1 0 -0.25' centerOfRotation='-1.3 0.7 0' fieldOfView='0.6'/>
    <SpotLight DEF='Key' location='-3.2 4.8 3.6' direction='0.48 -0.68 -0.55' color='1 0.88 0.7' intensity='30' radius='30' beamWidth='0.5' cutOffAngle='0.75' attenuation='1 0 0' shadowIntensity='0.8'/>
    <SpotLight DEF='Fill' location='4.2 2.4 4.2' direction='-0.66 -0.27 -0.7' color='0.8 0.78 1' intensity='7' radius='30' beamWidth='0.7' cutOffAngle='0.95' attenuation='1 0 0'/>
    <SpotLight DEF='Rim' location='1.5 3.5 -4.2' direction='-0.25 -0.55 0.8' color='1 0.6 0.3' intensity='26' radius='30' beamWidth='0.55' cutOffAngle='0.8' attenuation='1 0 0' shadowIntensity='0.5'/>
    <DirectionalLight direction='0 -1 -0.3' color='0.7 0.6 0.55' intensity='0.12'/>
    <Transform rotation='0 1 0 2.2'>
      <Shape>
        <Appearance><UnlitMaterial emissiveColor='0.32 0.27 0.26' emissiveTextureMapping='uv'><ImageTexture containerField='emissiveTexture' url='"starry_sky.jpg"'/></UnlitMaterial></Appearance>
        <Sphere radius='40' solid='false'/>
      </Shape>
    </Transform>
    <!-- floor: near-black, so the plinth floats in warm dark -->
    <Transform translation='0 -0.01 0'><Shape><Appearance><PhysicalMaterial baseColor='0.018 0.014 0.012' metallic='0' roughness='0.8'/></Appearance><Box size='60 0.02 60'/></Shape></Transform>
